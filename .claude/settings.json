{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(godot --headless *)",
      "PowerShell(godot --headless *)",
      "PowerShell(godot *)",
      "PowerShell(Get-Content*)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(Get-Command*)",
      "PowerShell(Test-Path*)",
      "PowerShell(Select-String*)",
      "PowerShell(Select-Object*)",
      "PowerShell(Out-File*)",
      "PowerShell(Measure-Object*)",
      "Bash(mkdir *)",
      "Bash(\"memory.md*)",
      "Bash(\"log.md*)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.claude/ai-helper/**)",
      "Write(.claude/ai-helper/**)",
      "Edit(.claude/ai-helper/diagrams/*.html)",
      "Write(.claude/ai-helper/diagrams/*.html)",
      "Edit(.claude/ai-helper/reviews/*.html)",
      "Write(.claude/ai-helper/reviews/*.html)",
      "Edit(.claude/ai-helper/design/*.html)",
      "Write(.claude/ai-helper/design/*.html)",
      "Edit(.claude/ai-helper/design/*.md)",
      "Write(.claude/ai-helper/design/*.md)",
      "Edit(data/*.gd)",
      "Edit(systems/*.gd)",
      "Edit(scenes/**/*.gd)",
      "Edit(test/**/*.gd)",
      "Edit(**/*.py)",
      "Write(**/*.py)",
      "Edit(CONTEXT.md)",
      "Edit(*.md)",
      "Write(*.md)",
      "Edit(docs/**/*.md)",
      "Write(docs/**/*.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'for f in .claude/ai-helper/memory.md .claude/ai-helper/log.md; do n=$(wc -l < \"$f\" 2>/dev/null || echo 0); if [ \"$n\" -gt 100 ]; then echo \"HOOK WARNING: $f has $n lines (limit 100) - run /dream before doing more work.\"; fi; done'"
          }
        ]
      }
    ]
  }
}
