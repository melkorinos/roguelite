[gd_scene format=3 uid="uid://shop000001"]

[ext_resource type="Script" path="res://scenes/Shop.gd" id="1_shop"]

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12
offset_left = 20.0
offset_top = 10.0
offset_right = -20.0
offset_bottom = -10.0

[node name="TopBar" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="RoundLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "Round 1"
theme_override_font_sizes/font_size = 24

[node name="GoldLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 1
text = "Gold: 10g"
theme_override_font_sizes/font_size = 24

[node name="HPLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
text = "HP: 30/30"
theme_override_font_sizes/font_size = 24

[node name="Separator1" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ShopHeader" type="Label" parent="VBox"]
layout_mode = 2
text = "FOR SALE"
theme_override_font_sizes/font_size = 20

[node name="ShopList" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="RerollRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="RerollSpacer" type="Control" parent="VBox/RerollRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="RerollButton" type="Button" parent="VBox/RerollRow"]
layout_mode = 2
text = "Reroll — 2g"
theme_override_font_sizes/font_size = 20

[node name="Separator2" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="InventoryHeader" type="Label" parent="VBox"]
layout_mode = 2
text = "INVENTORY  (6 slots)"
theme_override_font_sizes/font_size = 20

[node name="InventoryRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Separator3" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ForgeHeader" type="Label" parent="VBox"]
layout_mode = 2
text = "FORGE BENCH"
theme_override_font_sizes/font_size = 20

[node name="ForgeInfoLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "Select 2 inventory slots to combine"

[node name="ForgeActionsRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LevelUpButton" type="Button" parent="VBox/ForgeActionsRow"]
layout_mode = 2
text = "Level Up"
disabled = true

[node name="ForgeButton" type="Button" parent="VBox/ForgeActionsRow"]
layout_mode = 2
text = "Forge"
disabled = true

[node name="SellButton" type="Button" parent="VBox/ForgeActionsRow"]
layout_mode = 2
text = "Sell (½g)"
disabled = true

[node name="ForgeResultLabel" type="Label" parent="VBox/ForgeActionsRow"]
layout_mode = 2
size_flags_horizontal = 3
text = ""

[node name="Separator4" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="FightRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="FightSpacer" type="Control" parent="VBox/FightRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="FightButton" type="Button" parent="VBox/FightRow"]
layout_mode = 2
text = "► FIGHT"
theme_override_font_sizes/font_size = 24

[node name="Separator5" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="DebugRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="DebugLabel" type="Label" parent="VBox/DebugRow"]
layout_mode = 2
modulate = Color(1, 0.4, 0.4, 1)
text = "DEBUG"

[node name="DebugSpacer" type="Control" parent="VBox/DebugRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="TierLabel" type="Label" parent="VBox/DebugRow"]
layout_mode = 2
text = "Shop T1"

[node name="AddGoldButton" type="Button" parent="VBox/DebugRow"]
layout_mode = 2
text = "+10g"

[node name="TierUpButton" type="Button" parent="VBox/DebugRow"]
layout_mode = 2
text = "Tier ↑"

[connection signal="pressed" from="VBox/RerollRow/RerollButton" to="." method="_on_reroll_pressed"]
[connection signal="pressed" from="VBox/DebugRow/AddGoldButton" to="." method="_on_add_gold_pressed"]
[connection signal="pressed" from="VBox/DebugRow/TierUpButton" to="." method="_on_tier_up_pressed"]
[connection signal="pressed" from="VBox/ForgeActionsRow/LevelUpButton" to="." method="_on_level_up_pressed"]
[connection signal="pressed" from="VBox/ForgeActionsRow/ForgeButton" to="." method="_on_forge_pressed"]
[connection signal="pressed" from="VBox/ForgeActionsRow/SellButton" to="." method="_on_sell_pressed"]
[connection signal="pressed" from="VBox/FightRow/FightButton" to="." method="_on_fight_pressed"]
