[gd_scene format=3 uid="uid://battle00001"]

[ext_resource type="Script" path="res://scenes/Battle.gd" id="1_battle"]

[node name="Battle" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_battle")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
offset_left = 20.0
offset_top = 10.0
offset_right = -20.0
offset_bottom = -10.0

[node name="Header" type="Label" parent="VBox"]
layout_mode = 2
text = "BATTLE — Round 1"
theme_override_font_sizes/font_size = 28

[node name="Separator1" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="BattleRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 40

[node name="PlayerCol" type="VBoxContainer" parent="VBox/BattleRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="PlayerColHeader" type="Label" parent="VBox/BattleRow/PlayerCol"]
layout_mode = 2
text = "YOUR ITEMS"
theme_override_font_sizes/font_size = 20

[node name="PlayerItemList" type="VBoxContainer" parent="VBox/BattleRow/PlayerCol"]
layout_mode = 2

[node name="PlayerHP" type="Label" parent="VBox/BattleRow/PlayerCol"]
layout_mode = 2
text = "YOUR HP: 30"
theme_override_font_sizes/font_size = 22

[node name="OppCol" type="VBoxContainer" parent="VBox/BattleRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="OppColHeader" type="Label" parent="VBox/BattleRow/OppCol"]
layout_mode = 2
text = "OPPONENT"
theme_override_font_sizes/font_size = 20

[node name="OppName" type="Label" parent="VBox/BattleRow/OppCol"]
layout_mode = 2
text = "[Dummy Fighter]"
theme_override_font_sizes/font_size = 18

[node name="OppHP" type="Label" parent="VBox/BattleRow/OppCol"]
layout_mode = 2
text = "OPP HP: 20"
theme_override_font_sizes/font_size = 22

[node name="Separator2" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="TimerLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "⏱ 10s until SANDSTORM..."
