[node name="SandstormLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "SANDSTORM hits! -10 to both"
theme_override_font_sizes/font_size = 22
visible = false

[node name="Separator3" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ResultLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "Result: —"
