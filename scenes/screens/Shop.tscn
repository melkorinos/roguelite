[gd_scene format=3 uid="uid://shop000001"]

[ext_resource type="Script" path="res://scenes/screens/Shop.gd" id="1_shop"]
[ext_resource type="Script" path="res://scenes/slots/SellZone.gd" id="2_sellzone"]

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.07, 0.12, 1.0)
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 20.0
offset_top = 10.0
offset_right = -20.0
offset_bottom = -10.0
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="RoundLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "Round 1"
theme_override_font_sizes/font_size = 24

[node name="GoldLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 1
text = "Gold: 10g"
theme_override_font_sizes/font_size = 24

[node name="HPLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
text = "HP: 30/30"
theme_override_font_sizes/font_size = 24

[node name="LivesLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
text = "Life: 100  Wins: 0/10"
theme_override_font_sizes/font_size = 20

[node name="UndoButton" type="Button" parent="VBox/TopBar"]
layout_mode = 2
text = "↩ Undo"
theme_override_font_sizes/font_size = 18

[node name="DebugRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="DebugLabel" type="Label" parent="VBox/DebugRow"]
layout_mode = 2
modulate = Color(1, 0.4, 0.4, 1)
text = "DEBUG"

[node name="DebugSpacer" type="Control" parent="VBox/DebugRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="TierLabel" type="Label" parent="VBox/DebugRow"]
layout_mode = 2
text = "Shop T1"

[node name="AddGoldButton" type="Button" parent="VBox/DebugRow"]
layout_mode = 2
text = "+10g"

[node name="TierUpButton" type="Button" parent="VBox/DebugRow"]
layout_mode = 2
text = "Tier ↑"

[node name="AddElemButton" type="Button" parent="VBox/DebugRow"]
layout_mode = 2
text = "Add Elem ▾"

[node name="Separator1" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="MainArea" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 20

[node name="LeftPanel" type="VBoxContainer" parent="VBox/MainArea"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="SellZone" type="PanelContainer" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2
script = ExtResource("2_sellzone")

[node name="SellZoneVBox" type="VBoxContainer" parent="VBox/MainArea/LeftPanel/SellZone"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ShopHeaderRow" type="HBoxContainer" parent="VBox/MainArea/LeftPanel/SellZone/SellZoneVBox"]
layout_mode = 2

[node name="ShopHeader" type="Label" parent="VBox/MainArea/LeftPanel/SellZone/SellZoneVBox/ShopHeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "FOR SALE"
theme_override_font_sizes/font_size = 20

[node name="RerollButton" type="Button" parent="VBox/MainArea/LeftPanel/SellZone/SellZoneVBox/ShopHeaderRow"]
layout_mode = 2
text = "Reroll — 2g"
theme_override_font_sizes/font_size = 18

[node name="ShopGrid" type="GridContainer" parent="VBox/MainArea/LeftPanel/SellZone/SellZoneVBox"]
layout_mode = 2
columns = 5
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="SellHintLabel" type="Label" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2
horizontal_alignment = 1
modulate = Color(0.3, 1.0, 0.45, 0.9)
visible = false
text = "⬇  drag here to sell"
theme_override_font_sizes/font_size = 14

[node name="Separator2" type="HSeparator" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2

[node name="InventoryHeader" type="Label" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2
text = "INVENTORY  (6 slots)"
theme_override_font_sizes/font_size = 20

[node name="InventoryRow" type="HBoxContainer" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Separator3" type="HSeparator" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2

[node name="BattleGridHeader" type="Label" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2
text = "BATTLE GRID — 2×2  (drag from inventory)"
theme_override_font_sizes/font_size = 20

[node name="BattleGrid" type="GridContainer" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="Separator4" type="HSeparator" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2

[node name="FightRow" type="HBoxContainer" parent="VBox/MainArea/LeftPanel"]
layout_mode = 2

[node name="FightSpacer" type="Control" parent="VBox/MainArea/LeftPanel/FightRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="FightButton" type="Button" parent="VBox/MainArea/LeftPanel/FightRow"]
layout_mode = 2
text = "► FIGHT"
theme_override_font_sizes/font_size = 24

[node name="VSeparator" type="VSeparator" parent="VBox/MainArea"]
layout_mode = 2

[node name="RightPanel" type="VBoxContainer" parent="VBox/MainArea"]
layout_mode = 2
custom_minimum_size = Vector2(280, 0)
theme_override_constants/separation = 8

[node name="ForgeHeader" type="Label" parent="VBox/MainArea/RightPanel"]
layout_mode = 2
text = "FORGE BENCH"
theme_override_font_sizes/font_size = 20

[node name="ForgeHintLine" type="Label" parent="VBox/MainArea/RightPanel"]
layout_mode = 2
modulate = Color(0.7, 0.7, 0.7, 1)
text = "Drag items here · Press F to quick-forge"
theme_override_font_sizes/font_size = 13

[node name="ForgeSeparator" type="HSeparator" parent="VBox/MainArea/RightPanel"]
layout_mode = 2

[node name="ForgeInfoLabel" type="Label" parent="VBox/MainArea/RightPanel"]
layout_mode = 2
autowrap_mode = 3
text = "Drop 2 items to forge"

[node name="ForgeSlotsRow" type="HBoxContainer" parent="VBox/MainArea/RightPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ForgeButton" type="Button" parent="VBox/MainArea/RightPanel"]
layout_mode = 2
text = "⚒  Forge"
disabled = true

[node name="ForgeResultLabel" type="Label" parent="VBox/MainArea/RightPanel"]
layout_mode = 2
autowrap_mode = 3
text = ""

[connection signal="pressed" from="VBox/TopBar/UndoButton" to="." method="_on_undo_pressed"]
[connection signal="pressed" from="VBox/DebugRow/AddGoldButton" to="." method="_on_add_gold_pressed"]
[connection signal="pressed" from="VBox/DebugRow/TierUpButton" to="." method="_on_tier_up_pressed"]
[connection signal="pressed" from="VBox/DebugRow/AddElemButton" to="." method="_on_add_elem_pressed"]
[connection signal="pressed" from="VBox/MainArea/LeftPanel/SellZone/SellZoneVBox/ShopHeaderRow/RerollButton" to="." method="_on_reroll_pressed"]
[connection signal="pressed" from="VBox/MainArea/LeftPanel/FightRow/FightButton" to="." method="_on_fight_pressed"]
[connection signal="pressed" from="VBox/MainArea/RightPanel/ForgeButton" to="." method="_on_forge_button_pressed"]
[connection signal="sold" from="VBox/MainArea/LeftPanel/SellZone" to="." method="_on_sell_zone_sold"]
