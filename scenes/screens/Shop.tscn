[gd_scene format=3 uid="uid://shop000001"]

[ext_resource type="Script" path="res://scenes/screens/Shop.gd" id="1_shop"]
[ext_resource type="Script" path="res://scenes/slots/SellZone.gd" id="2_sellzone"]
[ext_resource type="Script" path="res://scenes/screens/ForgePanel.gd" id="3_forgepanel"]
[ext_resource type="Script" path="res://scenes/shared/ScenePanel.gd" id="4_scenepanel"]

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.07, 0.12, 1.0)
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 20.0
offset_top = 10.0
offset_right = -20.0
offset_bottom = -10.0
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="VBox"]
